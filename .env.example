# -----------------------------------------------
# TakeOne — variáveis de ambiente
# Copie para .env e preencha. Nunca commite o .env.
# -----------------------------------------------

# Banco
DATABASE_NAME=takeone
# Só para rodar API e worker fora do Docker. Dentro do Docker o compose já aponta para o serviço mongo.
# 27019 é a porta do Mongo do compose; troque para 27017 se usar um Mongo instalado na máquina.
MONGO_URI=mongodb://localhost:27019/?directConnection=true

# Sessão — gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
SESSAO_DIAS=7
# true quando o site estiver em HTTPS (túnel da Cloudflare)
COOKIE_SEGURO=false

# IA: "simulado" para desenvolver sem modelos, "real" para usar os modelos abertos instalados
MODO_IA=simulado

# Onde ficam os vídeos enviados e os arquivos gerados. Aponte para o disco com mais espaço.
PASTA_ARMAZENAMENTO_HOST=./armazenamento
# Maior arquivo aceito, e quanto espaço o disco precisa manter livre depois do envio
UPLOAD_MAX_GB=20
ESPACO_MINIMO_LIVRE_GB=2

# Portas neste computador. As padrão não batem com as do HolyCut (27018, 8000, 3000).
MONGO_PORTA=27019
API_PORTA=8010
WEB_PORTA=3010

# Backup diário do Mongo. Meia hora depois do HolyCut, para os dois não disputarem o disco.
BACKUP_HORA=03:30
BACKUP_RETENCAO_DIAS=14
# Pasta do computador onde os backups ficam (HD externo, Google Drive etc.)
PASTA_BACKUP_HOST=./backups

# Cloudflare Tunnel fixo (perfil "tunel"). Token criado no painel Zero Trust, que é gratuito.
CLOUDFLARE_TUNNEL_TOKEN=

# Banco de imagens e vídeos da Pixabay (chave gratuita em pixabay.com/api/docs). Vazia, ele fica desligado.
PIXABAY_CHAVE=
